<?xml version="1.0" encoding="utf-8"?>
<Configuration>
    <ViewDefinitions>
        <!-- AuthApp Table View -->
        <View>
            <Name>AuthApp</Name>
            <ViewSelectedBy>
                <TypeName>AuthApp</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Client ID</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Tenant ID</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Has Secret</Label>
                        <Width>12</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>ClientIdDisplay</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>TenantDisplay</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.ClientSecret) { "Yes" } else { "No" }
                                </ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- DnsRecord Table View -->
        <View>
            <Name>DnsRecord</Name>
            <ViewSelectedBy>
                <TypeName>DnsRecord</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Type</Label>
                        <Width>8</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Service Type</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Name</Label>
                        <Width>30</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Value</Label>
                        <Width>40</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>TTL</Label>
                        <Width>8</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ServiceType</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Value</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Ttl</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- VirtualTopology List View -->
        <View>
            <Name>VirtualTopology</Name>
            <ViewSelectedBy>
                <TypeName>VirtualTopology</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <Label>Domain Name</Label>
                                <PropertyName>DomainName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Tenant ID</Label>
                                <PropertyName>TenantIdDisplay</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Total Objects</Label>
                                <PropertyName>ObjectCount</PropertyName>
                            </ListItem>
                            <ListItem>
                                <Label>Network Regions</Label>
                                <ScriptBlock>
                                    if ($_.NetworkRegion) { $_.NetworkRegion.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Network Sites</Label>
                                <ScriptBlock>
                                    if ($_.NetworkSite) { $_.NetworkSite.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Network Subnets</Label>
                                <ScriptBlock>
                                    if ($_.NetworkSubnet) { $_.NetworkSubnet.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>PSTN Gateways</Label>
                                <ScriptBlock>
                                    if ($_.PstnGateway) { $_.PstnGateway.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Voice Routes</Label>
                                <ScriptBlock>
                                    if ($_.VoiceRoute) { $_.VoiceRoute.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Users</Label>
                                <ScriptBlock>
                                    if ($_.User) { $_.User.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                            <ListItem>
                                <Label>Dial Plans</Label>
                                <ScriptBlock>
                                    if ($_.DialPlan) { $_.DialPlan.Count } else { 0 }
                                </ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>

        <!-- VirtualUser Table View -->
        <View>
            <Name>VirtualUser</Name>
            <ViewSelectedBy>
                <TypeName>VirtualUser</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Identity</Label>
                        <Width>35</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Voice Status</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Phone Number</Label>
                        <Width>18</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Voice Policy</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Identity</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>VoiceStatus</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>TelephoneNumber</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>VoiceRoutingPolicy</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- VirtualVoiceRoute Table View -->
        <View>
            <Name>VirtualVoiceRoute</Name>
            <ViewSelectedBy>
                <TypeName>VirtualVoiceRoute</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Identity</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Priority</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Level</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Number Pattern</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Gateways</Label>
                        <Width>12</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                        <Width>30</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Identity</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Priority</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>PriorityLevel</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>NumberPattern</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>GatewayCount</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Description</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- VirtualPstnGateway Table View -->
        <View>
            <Name>VirtualPstnGateway</Name>
            <ViewSelectedBy>
                <TypeName>VirtualPstnGateway</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Identity (FQDN)</Label>
                        <Width>35</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Status</Label>
                        <Width>12</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Port</Label>
                        <Width>8</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Media Bypass</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Site ID</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Identity</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>SipSignalingPort</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>MediaBypassStatus</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>GatewaySiteId</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Description</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- VirtualDialPlan Table View -->
        <View>
            <Name>VirtualDialPlan</Name>
            <ViewSelectedBy>
                <TypeName>VirtualDialPlan</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Identity</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Simple Name</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>External Prefix</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Optimize Dialing</Label>
                        <Width>18</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                        <Width>30</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Identity</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>SimpleName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ExternalAccessPrefix</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>OptimizeDeviceDialing</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Description</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- VirtualNetworkSite Table View -->
        <View>
            <Name>VirtualNetworkSite</Name>
            <ViewSelectedBy>
                <TypeName>VirtualNetworkSite</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Site ID</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Region ID</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                        <Width>40</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>NetworkSiteId</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>NetworkRegionId</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Description</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- VirtualNetworkSubnet Table View -->
        <View>
            <Name>VirtualNetworkSubnet</Name>
            <ViewSelectedBy>
                <TypeName>VirtualNetworkSubnet</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Subnet CIDR</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Site ID</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                        <Width>40</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>SubnetCidr</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>NetworkSiteId</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Description</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- defaultVoiceRoute Table View -->
        <View>
            <Name>DefaultVoiceRoute</Name>
            <ViewSelectedBy>
                <TypeName>DefaultVoiceRoute</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Display Name</Label>
                        <Width>30</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Country</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Type</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Pattern</Label>
                        <Width>35</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>displayName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>countryCode</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>pattern</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- defaultVoiceNormalisationRule Table View -->
        <View>
            <Name>DefaultVoiceNormalisationRule</Name>
            <ViewSelectedBy>
                <TypeName>DefaultVoiceNormalisationRule</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Display Name</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Country</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Type</Label>
                        <Width>15</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Pattern</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Translation</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Area Code</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>displayName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>countryCode</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>pattern</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>translation</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>areaCode</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
